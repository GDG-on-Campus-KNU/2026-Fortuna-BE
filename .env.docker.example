APP_ENV=docker
API_PORT=8000
CORS_ORIGINS=*

# PostgreSQL service values used by docker-compose.yml.
# DATABASE_URL is constructed inside docker-compose.yml from these values.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=fortuna
POSTGRES_PORT=5432

# Security configuration.
# Generate a secure secret key with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini LLM and Gemini TTS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FRIENDLY_VOICE_NAME=Puck
GEMINI_TTS_PROFESSOR_VOICE_NAME=Kore
GEMINI_TTS_SAMPLE_RATE_HZ=24000
GEMINI_TTS_CHANNELS=1
GEMINI_TTS_SAMPLE_WIDTH=2

# TTS_PROVIDER can be gemini or google_cloud.
TTS_PROVIDER=gemini
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0

# STORAGE_BACKEND can be local or gcs.
# local uses ./storage mounted to /app/storage.
# gcs uses a private bucket and returns signed audio URLs.
STORAGE_BACKEND=local
GCS_BUCKET_NAME=
GCS_SIGNED_URL_EXPIRATION_MINUTES=60

# Required when STORAGE_BACKEND=gcs. The key is mounted read-only into the container.
GCS_KEY_FILE=./.gcs-key.json
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcs-key.json

# Compose-only metadata selector. docker-compose.yml maps this to METADATA_BACKEND.
# Use postgres for Docker by default so app state is not stored in JSON files.
COMPOSE_METADATA_BACKEND=postgres

MAX_UPLOAD_MB=20
# Optional absolute base URL for returned URLs.
PUBLIC_BASE_URL=

# Optional real PostgreSQL integration test URL when running tests outside Compose.
# POSTGRES_TEST_DATABASE_URL=replace-with-your-postgres-test-url
