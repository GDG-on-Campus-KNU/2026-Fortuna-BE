APP_ENV=local
# Use "*" only for local development. Credentialed CORS requires explicit origins.
CORS_ORIGINS=*

# PostgreSQL connection for local Python execution.
# The app accepts postgresql://, postgresql+asyncpg://, or postgresql+psycopg://.
DATABASE_URL=replace-with-your-database-url

# Security configuration.
# Generate a secure secret key with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Gemini LLM and Gemini TTS.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FRIENDLY_VOICE_NAME=Puck
GEMINI_TTS_PROFESSOR_VOICE_NAME=Kore
GEMINI_TTS_SAMPLE_RATE_HZ=24000
GEMINI_TTS_CHANNELS=1
GEMINI_TTS_SAMPLE_WIDTH=2

# TTS_PROVIDER can be gemini or google_cloud.
TTS_PROVIDER=gemini
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_AUDIO_ENCODING=MP3
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0

# STORAGE_BACKEND can be local or gcs.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
# Required only when STORAGE_BACKEND=gcs.
GCS_BUCKET_NAME=
GCS_SIGNED_URL_EXPIRATION_MINUTES=60

# METADATA_BACKEND can be json or postgres.
METADATA_BACKEND=json
METADATA_DIR=storage/metadata

MAX_UPLOAD_MB=20
# Optional absolute base URL for local static audio URLs.
PUBLIC_BASE_URL=

# Local Google Cloud auth for GCS or Google Cloud TTS.
# Example: GOOGLE_APPLICATION_CREDENTIALS=./.gcs-key.json
GOOGLE_APPLICATION_CREDENTIALS=

# Optional real PostgreSQL integration test URL.
# POSTGRES_TEST_DATABASE_URL=replace-with-your-postgres-test-url

# Google Cloud Run Deployment configurations
PROJECT_ID=replace-with-your-gcp-project-id
REGION=replace-with-your-gcp-region
SERVICE_NAME=replace-with-your-service-name
AR_REPO=replace-with-your-artifact-registry-repo-name

