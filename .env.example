APP_ENV=local
# Use "*" only for local development. Credentialed CORS requires explicit origins.
CORS_ORIGINS=

# PostgreSQL configuration (Use postgresql+asyncpg:// schema for async SQLAlchemy)
DATABASE_URL=

# Security configuration
# Generate a secure secret key using: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_FRIENDLY_VOICE_NAME=Puck
GEMINI_TTS_PROFESSOR_VOICE_NAME=Kore
GEMINI_TTS_SAMPLE_RATE_HZ=24000
GEMINI_TTS_CHANNELS=1
GEMINI_TTS_SAMPLE_WIDTH=2

TTS_PROVIDER=gemini
GOOGLE_TTS_LANGUAGE_CODE=ko-KR
GOOGLE_TTS_VOICE_NAME=
GOOGLE_TTS_AUDIO_ENCODING=
GOOGLE_TTS_SPEAKING_RATE=1.0
GOOGLE_TTS_PITCH=0.0

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
# Placeholder only until app.infra.storage.gcs is implemented.
GCS_BUCKET_NAME=

METADATA_BACKEND=json
METADATA_DIR=storage/metadata
# "postgres" is reserved for the future implementation.

MAX_UPLOAD_MB=20
PUBLIC_BASE_URL=

# Local Google Cloud auth only. Cloud Run should use service account permissions.
GOOGLE_APPLICATION_CREDENTIALS=
